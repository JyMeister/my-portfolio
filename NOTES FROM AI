.timeline-entry::before {
  content: '';
  width: 12px;
  height: 12px;
  background: #0073aa;
  border-radius: 50%;
  position: absolute;
  left: -7px;
  top: 6px;
}

.timeline-entry h3 {
  font-size: 1.25rem;
  margin-top: 0;
}

.timeline-entry ul {
  margin-top: 0.5rem;
  padding-left: 1.25rem;
  list-style: disc;
}

.timeline-entry a {
  color: #0073aa;
  text-decoration: underline;
